# Content Processor environment configuration (copy to .env; never commit .env)

ENVIRONMENT=development
LOG_LEVEL=INFO
LOG_FORMAT=json

# Ledger (Postgres). Integration and chaos tests run only when this is set.
CP_DATABASE_URL=postgresql://cp:cp@localhost:5432/content_processor

# Evidence store root (MinIO/S3 in Stage 1; local directory for Stage 0 fixtures)
CP_EVIDENCE_ROOT=./evidence

# Knowledge base (RFC 0002 stages 5-7). The vector store uses CP_DATABASE_URL when it
# points at Postgres with pgvector (tables in the `knowledge` schema); otherwise a local
# SQLite file under CP_KNOWLEDGE_ROOT. Model endpoints must be local or private-network.
CP_KNOWLEDGE_ROOT=./knowledge_store
CP_MODEL_ENDPOINT=http://localhost:11434/v1
CP_EMBED_MODEL=bge-m3
CP_CHAT_MODEL=qwen2.5:7b-instruct

# Bright Data (T4 proxies / T5 unlocker). Keep BRIGHTDATA_ENABLED=false until zones exist.
BRIGHTDATA_ENABLED=false
BRIGHTDATA_CUSTOMER_ID=
BRIGHTDATA_PROXY_ZONE=
BRIGHTDATA_PROXY_ZONE_PASSWORD=
BRIGHTDATA_UNLOCKER_ZONE=
BRIGHTDATA_UNLOCKER_ZONE_PASSWORD=
BRIGHTDATA_RUN_CAP_USD=5
BRIGHTDATA_DAILY_CAP_USD=25
BRIGHTDATA_MONTHLY_CAP_USD=0

# Guardrails (Rankuno core)
GUARDRAILS_ENABLED=true
MAX_SESSION_SPEND_USD=5
